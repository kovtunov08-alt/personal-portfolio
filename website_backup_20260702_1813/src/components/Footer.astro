---
import { profile } from '../data/profile'
const year = new Date().getFullYear()
---

<footer class="site-footer">
  <div class="container footer-inner">
    <p>© {year} {profile.name}. Сделано на Astro.</p>
    <div class="footer-links">
      <a href={profile.social.github} target="_blank" rel="noreferrer noopener">GitHub</a>
      <a href={profile.social.linkedin} target="_blank" rel="noreferrer noopener">LinkedIn</a>
      <a href={`mailto:${profile.email}`}>Email</a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    padding: 2rem 0 3rem;
    border-top: 1px solid var(--border);
    background: linear-gradient(180deg, rgba(248, 250, 252, 0), rgba(241, 245, 249, 0.65));
  }

  .footer-inner {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    color: var(--text-muted);
    font-size: 0.95rem;
  }

  .footer-inner p {
    margin: 0;
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .footer-links a {
    color: #334155;
    text-decoration: none;
    font-weight: 600;
    transition: color 0.2s ease, text-decoration-color 0.2s ease;
  }

  .footer-links a:hover,
  .footer-links a:focus-visible {
    color: var(--accent-strong);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  @media (min-width: 768px) {
    .footer-inner {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }
</style>
