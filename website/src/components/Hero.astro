---
import { profile } from '../data/profile'

const base = import.meta.env.BASE_URL
const portraitSrc = `${base}${profile.portrait.replace(/^\//, '')}`

const socialLinks = [
  { key: 'github', label: 'GitHub', href: profile.social.github },
  { key: 'linkedin', label: 'LinkedIn', href: profile.social.linkedin },
  { key: 'telegram', label: 'Telegram', href: profile.social.telegram },
] as const

const [firstName, ...restName] = profile.name.split(' ')
const lastName = restName.join(' ')
---

<section class="hero-landing" aria-labelledby="hero-title">
  <div class="container hero-shell">
    <div class="hero-content">
      <nav class="hero-nav" aria-label="Разделы первого экрана">
        {
          profile.nav.map((item) => (
            <a href={item.href}>{item.label}</a>
          ))
        }
      </nav>

      <div class="hero-content-body">
        <p class="hero-eyebrow" data-split-flap>VIBE CODING</p>
        <h1 id="hero-title" class="hero-title">
          <span class="hero-title-first">{firstName}</span>
          {lastName ? <span class="hero-title-last">{lastName}</span> : null}
        </h1>
        <p class="hero-role">{profile.title}</p>
        <p class="hero-lead">{profile.tagline}</p>

        <div class="hero-actions" role="group" aria-label="Основные действия">
          <a class="btn btn-primary accent-soft-surface" href="#projects" data-magnetic>Проекты</a>
          <a class="btn btn-secondary" href="#contact" data-magnetic>Связаться</a>
        </div>

        <div class="hero-meta">
          <span>{profile.location}</span>
          <a href={`mailto:${profile.email}`}>{profile.email}</a>
        </div>

        <nav class="hero-socials" aria-label="Социальные сети">
          {
            socialLinks.map((link) => (
              <a href={link.href} target="_blank" rel="noreferrer noopener" data-magnetic>
                {link.label}
              </a>
            ))
          }
        </nav>
      </div>
    </div>

    <figure class="hero-visual">
      <div class="hero-visual-stage">
        <div class="hero-visual-frame" data-tilt>
          <img
            class="hero-portrait"
            src={portraitSrc}
            alt=""
            width={profile.portraitWidth}
            height={profile.portraitHeight}
            decoding="async"
            fetchpriority="high"
          />
        </div>
      </div>
    </figure>
  </div>
</section>

<style is:global>
  .hero-landing {
    position: relative;
    width: 100%;
    min-height: 100svh;
    min-height: 100dvh;
    display: flex;
    align-items: flex-start;
    padding-block: clamp(1.25rem, 2.5vw, 1.75rem) clamp(1.5rem, 3.5vw, 2.5rem);
    background:
      radial-gradient(ellipse 55% 45% at 78% 28%, rgba(175, 80, 255, 0.14), transparent 70%),
      radial-gradient(ellipse 40% 35% at 12% 80%, rgba(225, 189, 255, 0.05), transparent 65%),
      var(--color-near-black);
  }

  .hero-shell {
    width: var(--container);
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(280px, 0.95fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }

  .hero-nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 1.25rem;
    margin-bottom: 1rem;
  }

  .hero-nav a {
    display: inline-flex;
    align-items: center;
    padding: 0.65rem 0;
    color: var(--color-ash);
    text-decoration: none;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    border-bottom: 1px solid transparent;
    transition:
      color 0.2s ease,
      border-color 0.2s ease;
  }

  .hero-nav a:hover,
  .hero-nav a:focus-visible {
    color: var(--color-almost-white);
    border-bottom-color: rgba(247, 249, 250, 0.35);
    outline: none;
  }

  .hero-content {
    max-width: 38rem;
  }

  .hero-eyebrow {
    margin: 0 0 0.35rem;
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(2rem, 5vw, 3.5rem);
    line-height: 0.95;
    letter-spacing: -0.03em;
    color: var(--color-almost-white);
  }

  .hero-title {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.1em;
    font-size: clamp(2.25rem, 5.5vw, 4rem);
    font-weight: 300;
    line-height: 1.02;
    letter-spacing: -0.04em;
    color: var(--color-almost-white);
  }

  .hero-title-last {
    font-weight: 400;
  }

  .hero-role {
    margin: 1.1rem 0 0;
    color: var(--color-steel);
    font-size: clamp(1rem, 2vw, 1.25rem);
    font-weight: 300;
    letter-spacing: -0.01em;
  }

  .hero-lead {
    margin: 1.1rem 0 0;
    color: rgba(247, 249, 250, 0.72);
    font-size: clamp(1rem, 1.6vw, 1.25rem);
    font-weight: 300;
    line-height: 1.55;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.9rem;
    padding: 1rem 1.25rem;
    border-radius: var(--radius-buttons);
    border: 1px solid transparent;
    font-size: 1rem;
    font-weight: 400;
    text-decoration: none;
    transition:
      background-color 0.2s ease,
      color 0.2s ease,
      border-color 0.2s ease;
  }

  .btn:focus-visible {
    outline: 2px solid var(--color-lavender-mist);
    outline-offset: 2px;
  }

  /* Soft accent — matches stack chips / submit */
  .btn-primary {
    background: var(--accent-soft);
    border-color: var(--accent-border);
    color: var(--color-lavender-mist);
    font-weight: 500;
  }

  .btn-primary:hover,
  .btn-primary:focus-visible {
    background: var(--accent-medium);
    border-color: var(--accent-border-hover);
  }

  .btn-secondary {
    background: var(--color-near-black);
    border-color: var(--color-almost-white);
    color: var(--color-almost-white);
  }

  .btn-secondary:hover,
  .btn-secondary:focus-visible {
    background: rgba(247, 249, 250, 0.06);
  }

  .hero-meta {
    margin-top: 1.5rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.2rem;
    color: var(--color-ash);
    font-size: 0.875rem;
  }

  .hero-meta a {
    color: var(--color-almost-white);
    text-decoration: underline;
    text-underline-offset: 0.2em;
    text-decoration-color: rgba(247, 249, 250, 0.35);
  }

  .hero-meta a:hover,
  .hero-meta a:focus-visible {
    text-decoration-color: var(--color-almost-white);
    outline: none;
  }

  .hero-socials {
    margin-top: 1rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1rem;
  }

  .hero-socials a {
    color: var(--color-steel);
    text-decoration: none;
    font-size: 0.875rem;
    font-weight: 500;
  }

  .hero-socials a:hover,
  .hero-socials a:focus-visible {
    color: var(--color-almost-white);
    text-decoration: underline;
    text-underline-offset: 0.22em;
    outline: none;
  }

  .hero-visual {
    margin: 0;
    justify-self: end;
    width: min(100%, 28rem, calc((100dvh - 3.5rem) * 683 / 1024));
  }

  .hero-visual-stage {
    perspective: 900px;
  }

  .hero-visual-frame {
    border-radius: var(--radius-cards);
    border: 1px solid rgba(247, 249, 250, 0.18);
    background: #121212;
    overflow: hidden;
    /* Matches portrait.png (683×1024) so the photo is not cropped */
    aspect-ratio: 683 / 1024;
    width: 100%;
    transform-style: preserve-3d;
    transform: rotateX(0deg) rotateY(0deg) scale(1);
    transition: box-shadow 0.25s ease;
    will-change: transform;
  }

  .hero-visual-frame:hover {
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.35);
  }

  .hero-portrait {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
    filter: saturate(0.92) contrast(1.04);
    transform: translateZ(18px);
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-visual-frame {
      will-change: auto;
    }

    .hero-portrait {
      transform: none;
    }
  }

  @media (max-width: 960px) {
    .hero-shell {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .hero-content {
      max-width: 100%;
    }

    .hero-visual {
      justify-self: start;
      width: min(100%, 26rem, calc((100dvh - 3.5rem) * 683 / 1024));
    }
  }

  @media (max-width: 640px) {
    .hero-landing {
      padding-block: 1.25rem 2rem;
      min-height: auto;
    }

    .hero-visual {
      width: min(100%, 26rem);
    }
  }
</style>
