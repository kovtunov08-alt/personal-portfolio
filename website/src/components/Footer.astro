---
import { profile } from '../data/profile'

/* Moscow — static postcard coordinate stamp */
const coords = '55.7558° N · 37.6173° E'
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <span class="footer-plus" aria-hidden="true">+</span>
      <div class="footer-copy">
        <p class="footer-line">{profile.title}</p>
        <p class="footer-line muted">{profile.location}</p>
      </div>
    </div>

    <div class="footer-stamp">
      <span class="footer-coords">{coords}</span>
      <span class="footer-heart" aria-hidden="true">♥</span>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    padding: 2.5rem 0 3rem;
    border-top: 1px solid rgba(247, 249, 250, 0.12);
    background: transparent;
  }

  .footer-inner {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .footer-brand {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
  }

  .footer-plus {
    color: var(--color-almost-white);
    font-size: 0.875rem;
    line-height: 1.4;
  }

  .footer-copy {
    display: grid;
    gap: 0.15rem;
  }

  .footer-line {
    margin: 0;
    font-size: 0.875rem;
    font-weight: 400;
    color: var(--color-almost-white);
  }

  .footer-line.muted {
    color: var(--color-steel);
  }

  .footer-stamp {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .footer-coords {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    letter-spacing: 0.04em;
    color: var(--color-almost-white);
  }

  .footer-heart {
    color: var(--color-almost-white);
    font-size: 0.8rem;
    line-height: 1;
  }

  @media (min-width: 768px) {
    .footer-inner {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }
</style>
