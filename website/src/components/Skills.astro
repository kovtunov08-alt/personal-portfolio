---
import { skillGroups } from '../data/skills'
---

<section id="skills" class="section" aria-labelledby="skills-title">
  <div class="container">
    <p class="section-label">Технологии</p>
    <h2 id="skills-title" class="section-title">Стек и инструменты</h2>
    <p class="section-lead">
      Технологии, которые использую в проектах, и направления, которые развиваю сейчас.
    </p>

    <div class="skills-grid">
      {
        skillGroups.map((group) => (
          <article class="skill-card card">
            <h3>{group.title}</h3>
            <ul>
              {group.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .skills-grid {
    display: grid;
    gap: 1rem;
  }

  .skill-card {
    padding: 1.5rem;
    border-color: var(--border-subtle);
  }

  .skill-card h3 {
    margin: 0 0 1rem;
    font-size: 1.12rem;
    color: #1e3a8a;
    letter-spacing: -0.01em;
  }

  .skill-card ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .skill-card li {
    padding: 0.45rem 0.8rem;
    border-radius: 999px;
    border: 1px solid #bfdbfe;
    background: #eff6ff;
    color: #1e40af;
    font-size: 0.9rem;
    font-weight: 600;
  }

  @media (min-width: 768px) {
    .skills-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
