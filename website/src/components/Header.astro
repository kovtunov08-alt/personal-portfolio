---
import { profile } from '../data/profile'

const base = import.meta.env.BASE_URL

const navItems = [
  { href: '#about', label: 'Обо мне' },
  { href: '#projects', label: 'Проекты' },
  { href: '#skills', label: 'Технологии' },
  { href: '#contact', label: 'Контакты' },
]
---

<header class="site-header" data-site-header>
  <div class="container header-inner">
    <a class="logo" href={base} aria-label={`${profile.name} — главная`}>
      <span class="logo-mark" aria-hidden="true"></span>
      <span>{profile.name.split(' ')[0]}</span>
    </a>

    <button
      class="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="site-nav"
      data-menu-toggle
    >
      <span class="sr-only">Открыть меню</span>
      <span aria-hidden="true"></span>
      <span aria-hidden="true"></span>
      <span aria-hidden="true"></span>
    </button>

    <nav id="site-nav" class="site-nav" aria-label="Основная навигация" data-site-nav>
      {
        navItems.map((item) => (
          <a href={item.href} data-nav-link data-section-link>
            {item.label}
          </a>
        ))
      }
      <a class="nav-cta" href="#contact" data-nav-link data-section-link>
        Связаться
      </a>
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector('[data-site-header]')
  const toggle = document.querySelector('[data-menu-toggle]')
  const nav = document.querySelector('[data-site-nav]')
  const links = document.querySelectorAll('[data-nav-link]')
  const sectionLinks = Array.from(
    document.querySelectorAll<HTMLAnchorElement>('[data-section-link]'),
  )
  const hero = document.querySelector('.hero-landing')

  const setHeaderVisible = (visible: boolean) => {
    if (!(header instanceof HTMLElement)) return

    header.classList.toggle('is-visible', visible)
    document.documentElement.classList.toggle('header-visible', visible)
  }

  if (hero instanceof HTMLElement && header instanceof HTMLElement) {
    const observer = new IntersectionObserver(
      ([entry]) => {
        if (!entry) return
        setHeaderVisible(!entry.isIntersecting)
      },
      { threshold: 0, rootMargin: '0px 0px -85% 0px' },
    )

    observer.observe(hero)
  }

  if (toggle instanceof HTMLButtonElement && nav instanceof HTMLElement) {
    toggle.addEventListener('click', () => {
      const isOpen = nav.classList.toggle('is-open')
      toggle.setAttribute('aria-expanded', String(isOpen))
    })

    links.forEach((link) => {
      link.addEventListener('click', () => {
        nav.classList.remove('is-open')
        toggle.setAttribute('aria-expanded', 'false')
      })
    })
  }

  const getSectionId = (href: string) => {
    if (!href.startsWith('#')) return null
    const id = href.slice(1).trim()
    return id.length > 0 ? id : null
  }

  const sectionEntries = sectionLinks
    .map((link) => {
      const href = link.getAttribute('href')
      if (!href) return null

      const sectionId = getSectionId(href)
      if (!sectionId) return null

      const section = document.getElementById(sectionId)
      if (!(section instanceof HTMLElement)) return null

      return { sectionId, section }
    })
    .filter((entry): entry is { sectionId: string; section: HTMLElement } => Boolean(entry))

  const setActiveSection = (sectionId: string | null) => {
    sectionLinks.forEach((link) => {
      const href = link.getAttribute('href')
      const linkSectionId = href ? getSectionId(href) : null
      const isActive = sectionId !== null && linkSectionId === sectionId

      link.classList.toggle('is-active', isActive)

      if (isActive) {
        link.setAttribute('aria-current', 'page')
      } else {
        link.removeAttribute('aria-current')
      }
    })
  }

  const projectsPin = document.querySelector('[data-projects-pin]')

  const setHeaderClear = (clear: boolean) => {
    if (!(header instanceof HTMLElement)) return
    header.classList.toggle('is-clear', clear)
  }

  const updateHeaderClearByScroll = () => {
    if (!(projectsPin instanceof HTMLElement)) {
      setHeaderClear(false)
      return
    }

    const rect = projectsPin.getBoundingClientRect()
    const viewportH = window.innerHeight || 1
    // Sticky showcase covers the screen: pin top has reached 0, pin still fills below the fold.
    const clear = rect.top <= 0 && rect.bottom > viewportH
    setHeaderClear(clear)
  }

  if (sectionEntries.length > 0 || projectsPin instanceof HTMLElement) {
    const getHeaderOffset = () => {
      if (!(header instanceof HTMLElement)) return 60
      return Math.max(header.offsetHeight + 12, 48)
    }

    const updateActiveSectionByScroll = () => {
      if (sectionEntries.length === 0) return

      const headerOffset = getHeaderOffset()
      let activeId = sectionEntries[0]?.sectionId ?? null

      sectionEntries.forEach((entry) => {
        const sectionTop = entry.section.getBoundingClientRect().top
        if (sectionTop - headerOffset <= 0) {
          activeId = entry.sectionId
        }
      })

      setActiveSection(activeId)
    }

    let isTicking = false
    const handleScroll = () => {
      if (isTicking) return
      isTicking = true

      window.requestAnimationFrame(() => {
        updateActiveSectionByScroll()
        updateHeaderClearByScroll()
        isTicking = false
      })
    }

    updateActiveSectionByScroll()
    updateHeaderClearByScroll()
    window.addEventListener('scroll', handleScroll, { passive: true })
    window.addEventListener('resize', handleScroll)
  }
</script>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 20;
    height: var(--header-height);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    background: rgba(51, 50, 72, 0.7);
    border-bottom: 1px solid var(--color-ash);
    transform: translateY(0);
    opacity: 1;
    pointer-events: auto;
    transition:
      transform 0.35s ease,
      opacity 0.35s ease,
      background 0.35s ease,
      border-color 0.35s ease,
      backdrop-filter 0.35s ease,
      -webkit-backdrop-filter 0.35s ease;
  }

  .site-header.is-clear {
    background: transparent;
    border-bottom-color: transparent;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
  }

  :global(.has-hero) .site-header {
    transform: translateY(-100%);
    opacity: 0;
    pointer-events: none;
  }

  :global(.has-hero) .site-header.is-visible {
    transform: translateY(0);
    opacity: 1;
    pointer-events: auto;
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 100%;
    gap: 1rem;
  }

  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    font-weight: 500;
    letter-spacing: -0.02em;
    color: var(--color-almost-white);
  }

  .logo-mark {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 999px;
    background: var(--color-almost-white);
  }

  .menu-toggle {
    display: inline-flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.25rem;
    width: 2.25rem;
    height: 2.25rem;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius-buttons);
    background: transparent;
    color: var(--color-almost-white);
    cursor: pointer;
  }

  .menu-toggle span:not(.sr-only) {
    display: block;
    width: 1.1rem;
    height: 1px;
    margin-inline: auto;
    background: currentColor;
  }

  .site-nav {
    position: fixed;
    inset: var(--header-height) 1rem auto;
    display: none;
    flex-direction: column;
    gap: 0.25rem;
    padding: 1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-cards);
    background: rgba(9, 9, 9, 0.96);
    box-shadow: none;
  }

  .site-nav.is-open {
    display: flex;
  }

  .site-nav a {
    padding: 0.4rem 0.75rem;
    border-radius: var(--radius-small);
    text-decoration: none;
    color: var(--color-steel);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    transition: color 0.2s ease;
  }

  .site-nav a:hover,
  .site-nav a:focus-visible {
    color: var(--color-almost-white);
    text-decoration: underline;
    text-underline-offset: 0.25em;
    outline: none;
  }

  .site-nav a.is-active {
    color: var(--color-almost-white);
  }

  .nav-cta {
    margin-top: 0.35rem;
    color: var(--color-almost-white) !important;
    background: var(--color-near-black) !important;
    border: 1px solid var(--color-almost-white);
    border-radius: var(--radius-buttons);
    font-weight: 400;
    text-align: center;
    text-transform: none !important;
    letter-spacing: 0 !important;
    font-size: 0.95rem !important;
  }

  .nav-cta:hover,
  .nav-cta:focus-visible {
    background: rgba(247, 249, 250, 0.06) !important;
    text-decoration: none !important;
  }

  .nav-cta.is-active {
    background: rgba(247, 249, 250, 0.08) !important;
  }

  @media (min-width: 768px) {
    .menu-toggle {
      display: none;
    }

    .site-nav {
      position: static;
      display: flex;
      flex-direction: row;
      align-items: center;
      padding: 0;
      border: 0;
      background: transparent;
      gap: 0.15rem;
    }

    .nav-cta {
      margin-top: 0;
      margin-left: 0.75rem;
      padding: 0.4rem 0.9rem !important;
    }
  }
</style>
