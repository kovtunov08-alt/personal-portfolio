---
import { profile } from '../data/profile'
---

<section id="about" class="section" aria-labelledby="about-title">
  <div class="container about-grid" data-reveal>
    <div>
      <p class="section-stamp" data-split-flap aria-hidden="true">ABOUT</p>
      <h2 id="about-title" class="section-title">Делаю продукты, которыми хочется пользоваться</h2>
    </div>
    <div class="about-copy liquid-glass" data-spotlight>
      {
        profile.bio.split('\n').map((paragraph) => (
          <p>{paragraph}</p>
        ))
      }
      <div class="about-links">
        <a class="accent-soft-surface" href={profile.social.github} target="_blank" rel="noreferrer noopener" data-magnetic>GitHub</a>
        <a class="accent-soft-surface" href={profile.social.linkedin} target="_blank" rel="noreferrer noopener" data-magnetic>LinkedIn</a>
        <a class="accent-soft-surface" href={profile.social.telegram} target="_blank" rel="noreferrer noopener" data-magnetic>Telegram</a>
      </div>
    </div>
  </div>
</section>

<style>
  .about-grid {
    display: grid;
    gap: 2rem;
    align-items: start;
  }

  .about-copy {
    padding: var(--card-padding);
    transform: scale(1);
    transition:
      transform 0.22s ease,
      filter 0.22s ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .about-copy:hover {
      transform: scale(0.985);
      filter: brightness(0.94);
    }
  }

  .about-copy p {
    margin: 0 0 1rem;
    color: var(--color-soft-white);
    font-size: 1.05rem;
    font-weight: 300;
    line-height: 1.7;
  }

  .about-copy p:last-of-type {
    margin-bottom: 1.5rem;
  }

  .about-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .about-links a {
    display: inline-flex;
    align-items: center;
    min-height: 2.5rem;
    padding: 0.55rem 0.95rem;
    border-radius: var(--radius-buttons);
    text-decoration: none;
  }

  .about-links a:focus-visible {
    outline: 2px solid var(--color-lavender-mist);
    outline-offset: 2px;
  }

  @media (min-width: 900px) {
    .about-grid {
      grid-template-columns: 0.9fr 1.1fr;
      gap: 3rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .about-copy {
      transition: none;
    }

    .about-copy:hover {
      transform: none;
      filter: none;
    }
  }
</style>
