---
import { getCollection } from 'astro:content'

const projects = (await getCollection('projects')).sort(
  (a, b) => a.data.order - b.data.order,
)
---

<section id="projects" class="section" aria-labelledby="projects-title">
  <div class="container">
    <p class="section-label">Проекты</p>
    <h2 id="projects-title" class="section-title">
      Проекты, над которыми работаю сейчас, и те, что уже реализовал.
    </h2>

    <div class="projects-grid">
      {
        projects.map((project) => (
          <article class="project-card card">
            <div class="project-media">
              {
                project.data.image ? (
                  <img
                    src={project.data.image}
                    alt={`Превью проекта ${project.data.title}`}
                    loading="lazy"
                    width="640"
                    height="360"
                  />
                ) : (
                  <div class="project-placeholder" aria-hidden="true" />
                )
              }
            </div>
            <div class="project-body">
              <div class="project-meta">
                <span>{project.data.year}</span>
              </div>
              <h3>
                {
                  project.data.link ? (
                    <a
                      href={project.data.link}
                      target="_blank"
                      rel="noreferrer noopener"
                      class="project-title-link"
                    >
                      {project.data.title}
                    </a>
                  ) : (
                    project.data.title
                  )
                }
              </h3>
              <p>{project.data.description}</p>
              <ul class="tags">
                {project.data.tags.map((tag) => (
                  <li>{tag}</li>
                ))}
              </ul>
              {
                project.data.link ? (
                  <a href={project.data.link} target="_blank" rel="noreferrer noopener">
                    Смотреть кейс →
                  </a>
                ) : null
              }
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .projects-grid {
    display: grid;
    gap: 1.5rem;
  }

  .project-card {
    overflow: hidden;
    display: grid;
    min-width: 0;
    border-color: var(--border-subtle);
  }

  .project-media {
    aspect-ratio: 16 / 9;
    background: linear-gradient(135deg, var(--accent-soft), transparent);
    border-bottom: 1px solid var(--border);
  }

  .project-media img,
  .project-placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .project-placeholder {
    background:
      linear-gradient(135deg, var(--accent-medium), rgba(15, 23, 42, 0.05)),
      var(--bg-elevated);
  }

  .project-body {
    display: grid;
    gap: 0.75rem;
    min-width: 0;
    padding: 1.5rem;
  }

  .project-meta {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    color: var(--text-muted);
    font-size: 0.875rem;
    font-weight: 600;
  }

  .project-meta span:first-child {
    color: var(--accent);
  }

  .project-body h3 {
    margin: 0;
    font-size: 1.35rem;
    letter-spacing: -0.02em;
  }

  .project-title-link {
    color: inherit;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .project-title-link:hover,
  .project-title-link:focus-visible {
    color: var(--accent-strong);
    outline: none;
  }

  .project-body p {
    margin: 0;
    color: var(--text-muted);
    overflow-wrap: break-word;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tags li {
    padding: 0.35rem 0.7rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: #f8fafc;
    font-size: 0.8rem;
    color: #334155;
    font-weight: 500;
  }

  .project-body a:not(.project-title-link) {
    width: fit-content;
    margin-top: 0.25rem;
    font-weight: 600;
    color: var(--accent-strong);
    text-decoration: none;
    transition: color 0.2s ease, transform 0.2s ease;
  }

  .project-body a:not(.project-title-link):hover,
  .project-body a:not(.project-title-link):focus-visible {
    color: var(--accent);
    transform: translateX(2px);
    outline: none;
  }

  @media (min-width: 768px) {
    .projects-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1100px) {
    .projects-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
