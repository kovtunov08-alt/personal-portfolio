---
import { profile } from '../data/profile'
import { FORMSPREE_ID } from '../data/formspree'

const formspreeId = import.meta.env.PUBLIC_FORMSPREE_ID?.trim() || FORMSPREE_ID
const formspreeEndpoint = formspreeId ? `https://formspree.io/f/${formspreeId}` : ''
---

<section id="contact" class="section" aria-labelledby="contact-title">
  <div class="container contact-grid" data-reveal>
    <div>
      <p class="section-stamp" data-split-flap aria-hidden="true">CONTACT</p>
      <h2 id="contact-title" class="section-title">Связаться</h2>
      <p class="section-lead">
        Если у вас есть вопросы, предложения или вы хотите обсудить сотрудничество — буду рад вашему сообщению.
      </p>
      <div class="contact-direct">
        <p class="contact-direct-heading">Контакты</p>
        <div class="contact-direct-item">
          <p>Прямой email</p>
          <a href={`mailto:${profile.email}`} data-magnetic>{profile.email}</a>
        </div>
        <div class="contact-direct-item">
          <p>Telegram</p>
          <a href={profile.social.telegram} target="_blank" rel="noopener noreferrer" data-magnetic>
            @{profile.social.telegram.replace('https://t.me/', '')}
          </a>
        </div>
      </div>
    </div>

    {
      formspreeEndpoint ? (
        <form
          class="contact-form liquid-glass"
          id="contact-form"
          method="post"
          action={formspreeEndpoint}
          data-spotlight
          novalidate
        >
          <div class="field">
            <label for="name">Имя</label>
            <input id="name" name="name" type="text" autocomplete="name" required minlength="2" />
          </div>

          <div class="field">
            <label for="email">Email</label>
            <input id="email" name="email" type="email" autocomplete="email" required />
          </div>

          <div class="field">
            <label for="message">Сообщение</label>
            <textarea id="message" name="message" rows="5" required minlength="10"></textarea>
          </div>

          <button class="submit" type="submit" data-magnetic>Отправить</button>
          <p class="form-status" id="form-status" role="status" aria-live="polite"></p>
        </form>
      ) : (
        <div class="contact-form contact-form-fallback liquid-glass" role="status">
          <p>
            Форма скоро будет подключена. Пока напишите напрямую на
            <a href={`mailto:${profile.email}`}>{profile.email}</a>.
          </p>
        </div>
      )
    }
  </div>
</section>

{
  formspreeEndpoint && (
    <script is:inline define:vars={{ formspreeEndpoint }}>
      const form = document.getElementById('contact-form')
      const status = document.getElementById('form-status')

      if (form instanceof HTMLFormElement && status instanceof HTMLElement) {
        form.addEventListener('submit', async (event) => {
          event.preventDefault()
          status.textContent = ''
          status.className = 'form-status'

          const submitButton = form.querySelector('button[type="submit"]')
          if (submitButton instanceof HTMLButtonElement) {
            submitButton.disabled = true
            submitButton.textContent = 'Отправка...'
          }

          try {
            const response = await fetch(formspreeEndpoint, {
              method: 'POST',
              body: new FormData(form),
              headers: { Accept: 'application/json' },
            })

            const payload = await response.json().catch(() => ({}))

            if (!response.ok) {
              const errors = payload.errors
              const firstError =
                Array.isArray(errors) && errors[0]?.message
                  ? errors[0].message
                  : payload.error
              throw new Error(firstError ?? 'Не удалось отправить сообщение.')
            }

            form.reset()
            status.textContent = 'Спасибо! Сообщение отправлено.'
            status.classList.add('is-success')
          } catch (error) {
            status.textContent =
              error instanceof Error ? error.message : 'Не удалось отправить сообщение.'
            status.classList.add('is-error')
          } finally {
            if (submitButton instanceof HTMLButtonElement) {
              submitButton.disabled = false
              submitButton.textContent = 'Отправить'
            }
          }
        })
      }
    </script>
  )
}

<style>
  .contact-grid {
    display: grid;
    gap: 2rem;
    align-items: start;
  }

  .contact-direct {
    display: grid;
    gap: 1rem;
    padding: 1.25rem 0;
    border-top: 1px solid var(--border-subtle);
  }

  .contact-direct-heading {
    margin: 0;
    color: var(--color-almost-white);
    font-size: 0.85rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.14em;
  }

  .contact-direct-item p {
    margin: 0 0 0.35rem;
    color: var(--color-ash);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }

  .contact-direct-item a {
    font-size: 1.1rem;
    font-weight: 400;
    text-decoration: none;
    color: var(--color-almost-white);
    border-bottom: 1px solid rgba(247, 249, 250, 0.3);
    transition: border-color 0.2s ease;
  }

  .contact-direct-item a:hover,
  .contact-direct-item a:focus-visible {
    border-bottom-color: var(--color-almost-white);
    outline: none;
  }

  .contact-form {
    display: grid;
    gap: 1rem;
    padding: var(--card-padding);
  }

  .contact-form-fallback p {
    margin: 0;
    color: var(--text-muted);
    line-height: 1.5;
  }

  .contact-form-fallback a {
    color: var(--color-almost-white);
    font-weight: 400;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .field {
    display: grid;
    gap: 0.45rem;
  }

  label {
    font-weight: 400;
    font-size: 0.875rem;
    color: var(--color-almost-white);
  }

  input,
  textarea {
    width: 100%;
    padding: 0.85rem 1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-buttons);
    background: var(--bg-input);
    color: var(--text);
    transition: border-color 0.2s ease;
  }

  input:focus-visible,
  textarea:focus-visible {
    border-color: var(--color-almost-white);
    outline: none;
  }

  .submit {
    min-height: 3rem;
    border: 1px solid var(--accent-border);
    border-radius: var(--radius-buttons);
    background: var(--accent-soft);
    color: var(--color-lavender-mist);
    font-weight: 500;
    cursor: pointer;
    transition:
      background 0.2s ease,
      border-color 0.2s ease;
  }

  .submit:hover:not(:disabled) {
    background: var(--accent-medium);
    border-color: var(--accent-border-hover);
  }

  button:focus-visible {
    outline: 2px solid var(--color-lavender-mist);
    outline-offset: 2px;
  }

  .submit:disabled {
    opacity: 0.7;
    cursor: wait;
  }

  .form-status {
    margin: 0;
    min-height: 1.25rem;
    font-size: 0.95rem;
  }

  .form-status.is-success {
    color: var(--color-lavender-mist);
    font-weight: 400;
  }

  .form-status.is-error {
    color: var(--danger);
  }

  @media (min-width: 900px) {
    .contact-grid {
      grid-template-columns: 0.85fr 1.15fr;
      gap: 3rem;
    }
  }
</style>
